# PostgreSQL connection string (Neon, local, or any Postgres provider).
# Neon: create a project at https://neon.tech, copy the "Connection string" (pooled, includes ?sslmode=require).
# Used by the running app (src/lib/prisma.ts, via @prisma/adapter-neon).
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Same Neon project/database, but the DIRECT (non-pooled) connection string —
# Neon dashboard: "Connection string" with pooling toggled off, i.e. the same
# host with "-pooler" removed. Used only by the Prisma CLI (prisma.config.ts)
# for `prisma migrate`/`prisma db push`/etc: Neon's pooled endpoint runs
# PgBouncer in transaction mode, which can't hold the session-scoped advisory
# lock `migrate deploy` needs, causing it to fail with P1002 ("Timed out
# trying to acquire a postgres advisory lock").
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# "development" | "production"
NODE_ENV="development"

# Used to mark cookies Secure in production and to build absolute links.
APP_BASE_URL="http://localhost:3000"
