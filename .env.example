# PostgreSQL connection string (Neon, local, or any Postgres provider).
# Neon: create a project at https://neon.tech, copy the "Connection string" (pooled, includes ?sslmode=require).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# "development" | "production"
NODE_ENV="development"

# Used to mark cookies Secure in production and to build absolute links.
APP_BASE_URL="http://localhost:3000"
